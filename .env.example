OPENROUTER_API_KEY=your_openrouter_api_key_here
PYTHONPATH=.

# LLM Configuration
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_FALLBACK_MODEL=mistralai/ministral-8b-2512
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=3

# Retrieval configuration (Phase 2 / Phase 3)
# RETRIEVAL_MODE: dense | hybrid | table
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=6
DENSE_CANDIDATE_K=20
BM25_CANDIDATE_K=20
RRF_K=60

# Cross-encoder reranker (optional; graceful fallback if model cannot load)
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2

# Table-aware retrieval (Phase 3)
TABLE_STORE_PATH=vectorstore/tables
TABLE_DENSE_INDEX_PATH=vectorstore/tables_index
TABLE_DENSE_ENABLED=true
TABLE_MAX_ROWS=200